# Operator Zero — Environment Variables
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local — it is listed in .gitignore.

# ─── Supabase ──────────────────────────────────────────────────────────────────
# Project URL — safe to expose in the browser (NEXT_PUBLIC_ prefix)
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co

# Publishable/anon key — safe to expose in the browser (NEXT_PUBLIC_ prefix)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<anon key>

# Service role key — SERVER ONLY. Never use NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=<service_role key>

# Access token for Supabase CLI (non-TTY supabase db push)
SUPABASE_ACCESS_TOKEN=<access token>

# Postgres connection for Drizzle — SERVER ONLY. Use the TRANSACTION POOLER URI
# (port 6543) with your DB PASSWORD (NOT an API key). Dashboard → Project Settings
# → Database → Connection string → Transaction pooler.
DATABASE_URL=postgresql://postgres.<ref>:<db-password>@aws-<n>-<region>.pooler.supabase.com:6543/postgres

# ─── Sentry ────────────────────────────────────────────────────────────────────
# Data Source Name — used in browser + server Sentry init
SENTRY_DSN=<dsn>

# Auth token for source-map upload — CI ONLY. Never put in browser bundles.
SENTRY_AUTH_TOKEN=<auth token>

# ─── Anthropic ─────────────────────────────────────────────────────────────────
# SERVER ONLY — never NEXT_PUBLIC_
ANTHROPIC_API_KEY=<key>

# ─── Groq ──────────────────────────────────────────────────────────────────────
# SERVER ONLY — never NEXT_PUBLIC_. Only needed when MODEL_PROFILE=groq|mixed
# or an OZ_MODEL_<ROLE> override routes a role to Groq.
GROQ_API_KEY=<key>

# ─── Google AI Studio (Gemini) ─────────────────────────────────────────────────
# SERVER ONLY — never NEXT_PUBLIC_. Only needed when MODEL_PROFILE=google or an
# OZ_MODEL_<ROLE> override routes a role to Google. GOOGLE_GENERATIVE_AI_API_KEY
# is the @ai-sdk/google package's default env var name — do not rename it.
# Get a key from Google AI Studio (aistudio.google.com/apikey).
GOOGLE_GENERATIVE_AI_API_KEY=<key>

# ─── Model routing ─────────────────────────────────────────────────────────────
# Which provider profile each agent role runs on. Default = anthropic (zero
# behavior change). Options: anthropic | groq | mixed | google
#   anthropic — ORCHESTRATOR=claude-opus-4-7, CLASSIFIER/AUDIT=claude-haiku-4-5, DRAFTER=claude-opus-4-5
#   groq      — ORCHESTRATOR/AUDIT/DRAFTER=openai/gpt-oss-120b, CLASSIFIER=openai/gpt-oss-20b
#   mixed     — Opus orchestrator + Groq classifier/audit (the "best results" default)
#   google    — ORCHESTRATOR/AUDIT/DRAFTER=gemini-2.5-flash, CLASSIFIER=gemini-2.5-flash-lite
#               (Flash on every role — latency + free-tier headroom; upgrade path
#               is OZ_MODEL_ORCHESTRATOR=google:gemini-2.5-pro)
MODEL_PROFILE=anthropic

# Optional per-role overrides — format "provider:modelId" (provider = anthropic|groq|google).
# Take precedence over MODEL_PROFILE. Leave commented to follow the profile above.
# OZ_MODEL_ORCHESTRATOR=groq:openai/gpt-oss-120b
# OZ_MODEL_CLASSIFIER=groq:openai/gpt-oss-20b
# OZ_MODEL_AUDIT=groq:openai/gpt-oss-120b
# OZ_MODEL_DRAFTER=anthropic:claude-opus-4-5
# OZ_MODEL_ORCHESTRATOR=google:gemini-2.5-pro

# ─── Voyage AI ─────────────────────────────────────────────────────────────────
# SERVER ONLY — never NEXT_PUBLIC_
VOYAGE_API_KEY=<key>

# ─── Encryption ────────────────────────────────────────────────────────────────
# 32-byte base64 key for libsodium secretbox token encryption
# Generate with: openssl rand -base64 32
# SERVER ONLY — never NEXT_PUBLIC_
ENCRYPTION_KEY=<32-byte base64 string>

# ─── Inngest ───────────────────────────────────────────────────────────────────
# Signing key from Inngest dashboard — SERVER ONLY
INNGEST_SIGNING_KEY=<signing key>

# Event key from Inngest dashboard — SERVER ONLY
INNGEST_EVENT_KEY=<event key>

# Set to "1" for local dev with Inngest dev server. Remove in Vercel env.
INNGEST_DEV=1

# ─── Upstash Redis (Rate Limiting) ─────────────────────────────────────────────
# SERVER ONLY — never NEXT_PUBLIC_
UPSTASH_REDIS_REST_URL=<url>
UPSTASH_REDIS_REST_TOKEN=<token>

# ─── Shopify Integration ──────────────────────────────────────────────────────
# App type: CUSTOM app (recommended for v1 beta — single store, no App Store review)
# Setup steps:
#   1. Create a Shopify Partner account at partners.shopify.com
#   2. Create a development store (Partners dashboard → Stores → Add store)
#   3. In your dev store admin → Settings → Apps and sales channels → Develop apps
#      → Create an app (custom app flow for v1)
#   4. Under "Configuration", set the Redirect URL to:
#      {your-origin}/api/integrations/shopify/callback
#      e.g. https://your-app.vercel.app/api/integrations/shopify/callback
#   5. Under "API credentials", copy Client ID and Client secret below
#   6. API version: use the latest stable (e.g. 2025-04)
#   7. Scopes: copy the required scopes string below exactly
#
# SERVER ONLY — never NEXT_PUBLIC_
SHOPIFY_CLIENT_ID=<client id from Shopify app credentials>
SHOPIFY_CLIENT_SECRET=<client secret from Shopify app credentials>
SHOPIFY_API_VERSION=2025-04
# Required scopes — copy this string exactly into your Shopify app configuration:
SHOPIFY_SCOPES=read_products,write_products,read_orders,read_content,write_content,read_inventory,write_inventory,read_themes,write_themes,read_locales,write_locales

# ─── Gmail Integration ────────────────────────────────────────────────────────
# IMPORTANT: These MAY be different credentials from the Supabase Google OAuth app.
# The Gmail integration requires the gmail.modify scope, which the Supabase login
# app does NOT typically have. You likely need a separate OAuth client for Gmail.
#
# Setup steps:
#   1. Go to Google Cloud Console (console.cloud.google.com)
#   2. Enable the Gmail API on your project (APIs & Services → Enable APIs → Gmail API)
#   3. Go to APIs & Services → OAuth consent screen:
#      - Add scope: https://www.googleapis.com/auth/gmail.modify
#      - Add your email as a test user (while the app is in testing)
#   4. Go to APIs & Services → Credentials → Create Credentials → OAuth 2.0 Client ID
#      - Application type: Web application
#      - Add Authorized redirect URI: {your-origin}/api/integrations/gmail/callback
#        e.g. https://your-app.vercel.app/api/integrations/gmail/callback
#        Also add for local dev: http://localhost:3000/api/integrations/gmail/callback
#   5. Copy the Client ID and Client Secret below
#
# NOTE: These keys are DIFFERENT from Supabase's Google OAuth credentials.
# Supabase handles login; these handle Gmail inbox access (gmail.modify scope).
#
# SERVER ONLY — never NEXT_PUBLIC_
GOOGLE_CLIENT_ID=<OAuth 2.0 client ID from Google Cloud Console — gmail.modify scope>
GOOGLE_CLIENT_SECRET=<OAuth 2.0 client secret from Google Cloud Console — gmail.modify scope>

# ─── App URL ────────────────────────────────────────────────────────────────────
# Public origin of this deployment — used to build the Shopify webhook callback
# URL (lib/integrations/shopify/sync.ts). Safe to expose in the browser.
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# ─── Demo / sandbox account ────────────────────────────────────────────────────
# SERVER ONLY — never NEXT_PUBLIC_. Identifies + gates the shared demo account
# used for the public sandbox and login page "Try the demo" flow.
# The UUID of the shared demo user row (lib/auth/demo.ts isDemoUser()).
DEMO_USER_ID=<uuid>
# Login credentials for the shared demo account (app/(auth)/login/actions.ts).
DEMO_EMAIL=<demo account email>
DEMO_PASSWORD=<demo account password>
# When "true", freezes the shared demo account's Shopify connection so visitors
# cannot disconnect/reconnect it (lib/auth/demo.ts). Unset/false by default.
DEMO_SHOPIFY_LOCKED=false
